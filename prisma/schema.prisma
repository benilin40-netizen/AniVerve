generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum WatchStatus {
  WATCHING
  COMPLETED
  PLAN_TO_WATCH
  DROPPED
  ON_HOLD
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  username            String          @unique
  passwordHash        String?
  avatarUrl           String?
  bio                 String?
  role                UserRole        @default(USER)
  status              AccountStatus   @default(ACTIVE)
  emailVerified       Boolean         @default(false)
  verificationToken   String?
  resetToken          String?
  resetTokenExpiresAt DateTime?
  firebaseUid         String?         @unique
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sessions            Session[]
  watchlists          Watchlist[]
  favorites           Favorite[]
  watchHistory        WatchHistory[]
  ratings             UserRating[]
  adminActivities     AdminActivity[]
  securityLogs        SecurityAuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Anime {
  id           Int             @id @default(autoincrement())
  anilistId    Int             @unique
  malId        Int?            @unique
  slug         String          @unique
  titleRomaji  String
  titleEnglish String?
  titleNative  String?
  format       String?
  status       String?
  season       String?
  seasonYear   Int?
  episodes     Int?
  duration     Int?
  coverImage   String?
  bannerImage  String?
  anilistScore Int?
  malScore     Float?
  malRank      Int?
  featured     Boolean         @default(false)
  hidden       Boolean         @default(false)
  categories   String[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  metadata     AnimeMetadata?
  episodeList  Episode[]
  watchlists   Watchlist[]
  favorites    Favorite[]
  watchHistory WatchHistory[]
  schedules    AiringSchedule[]
  ratings      UserRating[]

  @@index([anilistId])
  @@index([malId])
  @@index([featured])
  @@index([seasonYear, season])
}

model AnimeMetadata {
  id              String   @id @default(cuid())
  animeId         Int      @unique
  description     String?
  genres          String[]
  studios         String[]
  trailerId       String?
  trailerSite     String?
  charactersJson  Json?
  staffJson       Json?
  relationsJson   Json?
  recommendations Json?
  malInfoJson     Json?
  syncedAt        DateTime @default(now())

  anime           Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
}

model AnimeProvider {
  id                 String    @id @default(cuid())
  key                String    @unique
  name               String
  role               String    @default("primary")
  adapterType        String
  baseUrl            String?
  urlTemplate        String
  supportedIdTypes   String[]
  supportedLanguages String[]
  isEnabled          Boolean   @default(false)
  licenseVerified    Boolean   @default(false)
  embeddingAllowed   Boolean?
  availabilityStatus String    @default("unverified")
  verificationNotes  String?
  verifiedAt         DateTime?
  lastHttpStatus     Int?
  lastSuccessAt      DateTime?
  priority           Int       @default(1)
  errorCount         Int       @default(0)
  lastError          String?
  lastCheckedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isEnabled, priority])
}

model Episode {
  id          String    @id @default(cuid())
  animeId     Int
  number      Int
  title       String?
  thumbnail   String?
  airingAt    DateTime?
  durationSec Int?

  anime       Anime     @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@unique([animeId, number])
  @@index([animeId])
}

model Watchlist {
  id              String      @id @default(cuid())
  userId          String
  animeId         Int?
  anilistId       Int
  animeTitle      String
  animeSlug       String
  coverImage      String?
  totalEpisodes   Int?
  status          WatchStatus @default(PLAN_TO_WATCH)
  episodesWatched Int         @default(0)
  notes           String?
  updatedAt       DateTime    @updatedAt
  createdAt       DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime           Anime?      @relation(fields: [animeId], references: [id], onDelete: SetNull)

  @@unique([userId, anilistId])
  @@index([userId, status])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  animeId    Int?
  anilistId  Int
  animeTitle String
  animeSlug  String
  coverImage String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime      Anime?   @relation(fields: [animeId], references: [id], onDelete: SetNull)

  @@unique([userId, anilistId])
  @@index([userId])
}

model WatchHistory {
  id            String   @id @default(cuid())
  userId        String
  animeId       Int?
  anilistId     Int
  animeTitle    String
  animeSlug     String
  coverImage    String?
  episodeNumber Int
  providerKey   String
  language      String   @default("sub")
  progressSec   Int      @default(0)
  durationSec   Int      @default(0)
  completed     Boolean  @default(false)
  watchedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime         Anime?   @relation(fields: [animeId], references: [id], onDelete: SetNull)

  @@unique([userId, anilistId, episodeNumber])
  @@index([userId, watchedAt])
}

model AiringSchedule {
  id         String   @id @default(cuid())
  anilistId  Int
  animeId    Int?
  episode    Int
  airingAt   DateTime
  timeUntil  Int?
  title      String
  coverImage String?
  format     String?
  updatedAt  DateTime @updatedAt

  anime      Anime?   @relation(fields: [animeId], references: [id], onDelete: SetNull)

  @@unique([anilistId, episode])
  @@index([airingAt])
}

model AdminActivity {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String
  details   Json?
  createdAt DateTime @default(now())

  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@index([createdAt])
}

model SecurityAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  event     String
  success   Boolean  @default(true)
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

model ErrorLog {
  id         String   @id @default(cuid())
  requestId  String?
  source     String
  route      String?
  statusCode Int?
  message    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ApiCache {
  key       String   @id
  source    String
  payload   Json
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model UserRating {
  id        String   @id @default(cuid())
  userId    String
  animeId   Int?
  anilistId Int
  score     Int
  review    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime     Anime?   @relation(fields: [animeId], references: [id], onDelete: SetNull)

  @@unique([userId, anilistId])
  @@index([anilistId])
}
