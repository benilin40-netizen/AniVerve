# Database Connection (PostgreSQL / Prisma reference for Vercel / external Postgres)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aniverve?schema=public

# Authentication & Session Security
AUTH_SECRET=replace-with-a-64-char-cryptographic-secret
ADMIN_ACCESS_PASSWORD=
DISABLE_HMR=true

# Application URL
APP_URL=http://localhost:3000

# External Anime APIs (Server-side only)
ANILIST_API_URL=https://graphql.anilist.co
JIKAN_API_URL=https://api.jikan.moe/v4

# Unified Two-Provider Streaming System (Yenime Primary + AniEmbed Backup)
YENIME_API_BASE_URL="https://api.yenime.net"
YENIME_EMBED_TEMPLATE="https://player.yenime.net/anime/ani/{ANILIST_ID}/{EPISODE}"

ANIEMBED_BASE_URL="https://aniembed.se/e"
ANIEMBED_EMBED_TEMPLATE="https://aniembed.se/e/{ANILIST_ID}/{EPISODE}?lang={LANG}&autoplay={AUTOPLAY}&t={START}"

# Supabase Configuration (Server-side & Vite Client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
